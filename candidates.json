        "priority": 1,
        "failover_group": "liu673cn-box"
      },
      {
        "id": "liu673cn-jsdelivr",
        "name": "综合点播仓（CDN加速）",
        "kind": "json",
        "url": "https://fastly.jsdelivr.net/gh/liu673cn/box@main/m.json",
        "priority": 2,
        "failover_group": "liu673cn-box"
      },
      {
        "id": "liu673cn-ghpages",
        "name": "综合点播仓（Pages镜像）",
        "kind": "json",
        "url": "https://liu673cn.github.io/box/m.json",
        "priority": 3,
        "failover_group": "liu673cn-box",
        "timeout_seconds": 8
      },
      {
        "id": "selfhost-snapshot",
        "name": "综合点播仓（自托管快照-兜底）",
